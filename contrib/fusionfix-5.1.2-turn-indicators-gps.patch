+// GPS-driven blinkers: with a waypoint set, the automatic blinkers also follow the GPS route, the way the GPS voice
+// does. GENERATE_DIRECTIONS (the call behind the GPS voice) gives the next instruction towards the waypoint:
+// 0 none, 1 turn right, 2 turn left, 3 straight on, 4 turn around (found by driving logged routes). It reports a turn
+// from shortly before the junction until the turn is made, so the blinker comes on ahead of it and goes off after.
+namespace GpsBlinkers
+{
+    // FusionFix's NativeInvoke only copies Vector3 out-parameters back for natives with a return value, and these two
+    // are void: call them through a context and copy the vectors back explicitly.
+    template<typename... Args>
+    void InvokeWithVectors(uint32_t hash, Args... args)
+    {
+        NativeContext cxt;
+        (cxt.Push(args), ...);
+        if (auto fn = NativeInvoke::GetNativeHandler(hash))
+        {
+            fn(&cxt);
+            static_cast<scrNativeCallContext&>(cxt).GetResult<int32_t>(0);
+        }
+    }
+
+    constexpr uint32_t BLIP_COORD = 4, SPRITE_WAYPOINT = 8;
+
+    // 0 none, 1 left, 2 right (the turn indicator directions)
+    int Direction()
+    {
+        static float timer = 0.0f;
+        static int last = 0;
+        timer += 1000.0f * Natives::Timestep();
+        if (timer < 250.0f)
+            return last;
+        timer = 0.0f;
+        last = 0;
+        Blip b = Natives::GetFirstBlipInfoId(BLIP_COORD);
+        for (int n = 0; n < 64 && b && Natives::DoesBlipExist(b); n++, b = Natives::GetNextBlipInfoId(BLIP_COORD))
+        {
+            if (Natives::GetBlipSprite(b) != SPRITE_WAYPOINT)
+                continue;
+            Vector3 target{};
+            InvokeWithVectors(std::to_underlying(Natives::NativeHashes::GET_BLIP_COORDS), b, &target);
+            if (target.fX == 0.0f && target.fY == 0.0f)
+                break;
+            int32_t instruction = 0;
+            Vector3 unused{};
+            InvokeWithVectors(std::to_underlying(Natives::NativeHashes::GENERATE_DIRECTIONS), target.fX, target.fY, target.fZ, &instruction, &unused);
+            last = (instruction == 2) ? 1 : (instruction == 1) ? 2 : 0;
+            break;
+        }
+        return last;
+    }
+}
