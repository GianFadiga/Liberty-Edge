index 0000000..6a29473
--- /dev/null
+++ b/source/headlightcycle.ixx
@@ -0,0 +1,141 @@
+module;
+
+#include <common.hxx>
+#include <unordered_map>
+#include <vector>
+#include <cstdio>
+
+export module headlightcycle;
+
+import common;
+import comvars;
+import natives;
+
+// Headlight cycle: keeps the game's automatic headlights and lets the headlight key cycle
+//   Automatic -> High beam -> Low beam (forced on) -> Off -> Automatic
+// The game itself toggles the high beam on every press of its headlight key, and a high beam stays lit even when the
+// lights are forced off. So the high beam is only toggled on the way into and out of High beam (Automatic -> High,
+// High -> Low); for the other two presses the game's own switch is suppressed (SET_SUPPRESS_HEADLIGHT_SWITCH):
+//   0 Automatic: FORCE_CAR_LIGHTS 0 (game default), high beam off
+//   1 High beam: FORCE_CAR_LIGHTS 0, high beam on (game)
+//   2 Low beam : FORCE_CAR_LIGHTS 2 (on), high beam off (game)
+//   3 Off      : FORCE_CAR_LIGHTS 1 (off), high beam off (switch suppressed)
+// The state is kept per vehicle, so getting back into a car resumes its cycle.
+
+// Debug aid ([HEADLIGHTS] HeadlightDebug = 1): finds where the vehicle keeps its high beam state. Every frame the player's
+// vehicle (first 0x1800 bytes) is snapshotted; bytes that change on their own are learnt as noise. When the headlight
+// key is pressed, the bytes that differ 10 frames later (and are not noise) are written to HeadlightDebug.log.
+namespace HeadlightDebug
+{
+    constexpr size_t kSize = 0x1800;
+    std::vector<uint8_t> prev, pre, noise;
+    int countdown = -1;
+    int presses = 0;
+    void* lastVeh = nullptr;
+
+    bool Copy(void* src, std::vector<uint8_t>& dst)
+    {
+        dst.resize(kSize);
+        __try { memcpy(dst.data(), src, kSize); return true; }
+        __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+    }
+
+    void Log(const char* text)
+    {
+        wchar_t path[MAX_PATH];
+        GetModuleFileNameW(NULL, path, MAX_PATH);
+        std::wstring p = path; p = p.substr(0, p.find_last_of(L"\\/") + 1) + L"HeadlightDebug.log";
+        FILE* f = nullptr;
+        if (_wfopen_s(&f, p.c_str(), L"a") == 0 && f) { fputs(text, f); fclose(f); }
+    }
+
+    void Frame(void* veh, bool pressed, int step)
+    {
+        if (!veh) { lastVeh = nullptr; countdown = -1; return; }
+        std::vector<uint8_t> cur;
+        if (!Copy(veh, cur)) return;
+        if (veh != lastVeh) { lastVeh = veh; prev = cur; noise.assign(kSize, 0); countdown = -1; return; }
+        if (pressed) { pre = prev; countdown = 10; presses++; }
+        else if (countdown < 0)
+            for (size_t i = 0; i < kSize; i++) if (cur[i] != prev[i]) noise[i] = 1;
+        if (countdown > 0) countdown--;
+        else if (countdown == 0)
+        {
+            countdown = -1;
+            std::string out = std::format("press {} (cycle step {}), vehicle {}:", presses, step, veh);
+            int n = 0;
+            for (size_t i = 0; i < kSize && n < 64; i++)
+                if (!noise[i] && cur[i] != pre[i]) { out += std::format(" +0x{:X}:{:02X}->{:02X}", i, pre[i], cur[i]); n++; }
+            out += "\n";
+            Log(out.c_str());
+        }
+        prev = std::move(cur);
+    }
+}
+
+class HeadlightCycle
+{
+public:
+    HeadlightCycle()
+    {
+        FusionFix::onInitEventAsync() += []()
+        {
+            CIniReader iniReader("");
+            static bool bEnabled = iniReader.ReadInteger("HEADLIGHTS", "CycleHeadlights", 0) != 0;
+            static int32_t nKey = iniReader.ReadInteger("HEADLIGHTS", "HeadlightKey", 'H');
+            static bool bNotice = iniReader.ReadInteger("HEADLIGHTS", "ShowNotice", 1) != 0;
+            static bool bDebug = iniReader.ReadInteger("HEADLIGHTS", "HeadlightDebug", 0) != 0;
+            if (!bEnabled)
+                return;
+
+            FusionFix::onGameProcessEvent() += []()
+            {
+                static std::unordered_map<Vehicle, int32_t> steps;
+                static bool prevDown = false;
+
+                Ped player = 0;
+                Natives::GetPlayerChar(Natives::ConvertIntToPlayerIndex(Natives::GetPlayerId()), &player);
+                Vehicle car = 0;
+                if (player && Natives::IsCharInAnyCar(player))
+                    Natives::GetCarCharIsUsing(player, &car);
+                Ped driver = 0;
+                if (car)
+                    Natives::GetDriverOfCar(car, &driver);
+
+                bool down = IsKeyboardKeyPressed(nKey);
+                bool pressed = down && !prevDown;
+                prevDown = down;
+                bool driving = car && driver == player;
+                if (bDebug)
+                    HeadlightDebug::Frame(driving ? FindPlayerVehicle(0) : nullptr, driving && pressed, driving ? (steps[car] + (pressed ? 1 : 0)) % 4 : 0);
+
+                if (steps.size() > 32)
+                    steps.clear();
+                int32_t step = driving ? steps[car] : 0;
+
+                if (driving && pressed)
+                {
+                    step = (step + 1) % 4;
+                    steps[car] = step;
+                    static const int32_t force[4] = { 0, 0, 2, 1 };
+                    Natives::ForceCarLights(car, force[step]);
+                    if (bNotice)
+                    {
+                        static const char* names[4] = { "Headlights: automatic", "Headlights: high beam", "Headlights: low beam", "Headlights: off" };
+                        Natives::PrintStringWithLiteralStringNow((char*)"STRING", (void*)names[step], 1500, true);
+                    }
+                }
+
+                // The next press toggles the game's high beam only when it leads into or out of High beam
+                // (Automatic -> High, High -> Low); from Low and Off the game's switch is suppressed.
+                // Like other script flags, the suppression is cleared by the game every frame, so it is set every frame.
+                bool suppress = driving && (step == 2 || step == 3);
+                static bool lastSuppress = false;
+                if (suppress || lastSuppress)
+                    Natives::SetSuppressHeadlightSwitch(suppress);
+                lastSuppress = suppress;
+                return;
+            };
+        };
+    }
+} HeadlightCycle;
