diff --git a/source/headlightcycle.ixx b/source/headlightcycle.ixx
new file mode 100644
index 0000000..891dc02
--- /dev/null
+++ b/source/headlightcycle.ixx
@@ -0,0 +1,98 @@
+module;
+
+#include <common.hxx>
+#include <unordered_map>
+
+export module headlightcycle;
+
+import common;
+import comvars;
+import natives;
+
+// Headlight cycle: keeps the game's automatic headlights and lets the headlight key cycle
+//   Automatic -> High beam -> Low beam (forced on) -> Off -> Automatic
+// FORCE_CAR_LIGHTS forces the headlights on/off but does not touch the high beam, which the game toggles on every
+// press of its headlight key. The high beam is a flag in the vehicle (bit 0x02 of the byte at +0xF19 on 1.2.0.59,
+// found by watching which bytes change on each press), so the cycle sets that bit itself every frame for the state it is in:
+//   0 Automatic: FORCE_CAR_LIGHTS 0 (game default), high beam off
+//   1 High beam: FORCE_CAR_LIGHTS 0, high beam on
+//   2 Low beam : FORCE_CAR_LIGHTS 2 (on), high beam off
+//   3 Off      : FORCE_CAR_LIGHTS 1 (off), high beam off
+// The vehicle layout differs between game versions by 0x50 bytes. The layout is confirmed at runtime from the byte
+// that FORCE_CAR_LIGHTS writes (+0x10C2 or +0x1112) before the high beam bit is touched.
+// The state is kept per vehicle, so getting back into a car resumes its cycle.
+
+class HeadlightCycle
+{
+public:
+    HeadlightCycle()
+    {
+        FusionFix::onInitEventAsync() += []()
+        {
+            CIniReader iniReader("");
+            static bool bEnabled = iniReader.ReadInteger("HEADLIGHTS", "CycleHeadlights", 0) != 0;
+            static int32_t nKey = iniReader.ReadInteger("HEADLIGHTS", "HeadlightKey", 'H');
+            static bool bNotice = iniReader.ReadInteger("HEADLIGHTS", "ShowNotice", 1) != 0;
+            if (!bEnabled)
+                return;
+
+            FusionFix::onGameProcessEvent() += []()
+            {
+                static std::unordered_map<Vehicle, int32_t> steps;
+                static bool prevDown = false;
+
+                Ped player = 0;
+                Natives::GetPlayerChar(Natives::ConvertIntToPlayerIndex(Natives::GetPlayerId()), &player);
+                Vehicle car = 0;
+                if (player && Natives::IsCharInAnyCar(player))
+                    Natives::GetCarCharIsUsing(player, &car);
+                Ped driver = 0;
+                if (car)
+                    Natives::GetDriverOfCar(car, &driver);
+
+                bool down = IsKeyboardKeyPressed(nKey);
+                bool pressed = down && !prevDown;
+                prevDown = down;
+                bool driving = car && driver == player;
+
+                if (steps.size() > 32)
+                    steps.clear();
+                int32_t step = driving ? steps[car] : 0;
+
+                // 0 = unknown, otherwise the offset of the high beam byte
+                static ptrdiff_t highBeamOffset = 0;
+                auto veh = driving ? (uint8_t*)FindPlayerVehicle(0) : nullptr;
+
+                if (driving && pressed)
+                {
+                    step = (step + 1) % 4;
+                    steps[car] = step;
+                    static const int32_t force[4] = { 0, 0, 2, 1 };
+                    Natives::ForceCarLights(car, force[step]);
+                    if (veh && !highBeamOffset && force[step] != 0)
+                    {
+                        if (veh[0x10C2] == force[step])
+                            highBeamOffset = 0xF19;
+                        else if (veh[0x10C2 + 0x50] == force[step])
+                            highBeamOffset = 0xF19 + 0x50;
+                    }
+                    if (bNotice)
+                    {
+                        static const char* names[4] = { "Headlights: automatic", "Headlights: high beam", "Headlights: low beam", "Headlights: off" };
+                        Natives::PrintStringWithLiteralStringNow((char*)"STRING", (void*)names[step], 1500, true);
+                    }
+                }
+
+                // The high beam follows the cycle, whatever the game's own toggle did on this press
+                if (veh && highBeamOffset)
+                {
+                    uint8_t& flags = veh[highBeamOffset];
+                    uint8_t wanted = (step == 1) ? (flags | 0x02) : (flags & ~0x02);
+                    if (flags != wanted)
+                        flags = wanted;
+                }
+                return;
+            };
+        };
+    }
+} HeadlightCycle;
