+    mul r2.w, r2.w, r3.x
+    mul r2.w, r2.w, c5.z
+    rcp r3.y, r2.x
+    mul r2.w, r2.w, r3.y
+    dp3 r3.z, v3, v3
+    max r3.z, r3.z, c4.x
+    rsq r3.z, r3.z
+    mul r4.xyz, v3, r3.z
+    mul r4.xyz, r4, r2.w
+    mul r5, c9, r4.y
+    mad r5, r4.x, c8, r5
+    mad r5, r4.z, c10, r5
+    add r0, r0, r5
+    min r2.z, r2.z, c5.y
+    max r2.z, r2.z, c6.x
+    add r6.x, r2.z, -c5.y
+    mad r6.x, r3.x, r6.x, c5.y
+    mov o3.y, r6.x
+    // ---- end Liberty Edge Wire AA ----
     mov o0, r0
     mov o10.zw, r0
     mov o2.w, r0.w
