diff --git a/source/ledownsample.ixx b/source/ledownsample.ixx
new file mode 100644
index 0000000..59727a4
--- /dev/null
+++ b/source/ledownsample.ixx
@@ -0,0 +1,287 @@
+module;
+
+#include <common.hxx>
+#include <d3dx9.h>
+
+export module ledownsample;
+
+import common;
+import comvars;
+import d3dx9_43;
+
+// Liberty Edge: proper downsampling for supersampling ([LIBERTYEDGE] Downsample = 1).
+//
+// With a game resolution above the monitor, the backbuffer is e.g. 3840x2160 and DXVK scales it to the
+// 1920x1080 swapchain when presenting. For integer ratios DXVK's present blit fetches a single texel per
+// output pixel (floor((x + 0.5) * ratio)), which throws away 3 of every 4 samples: the picture looks like
+// native 1080p. This pass runs at the end of the frame (after the HUD) and writes, into every backbuffer
+// texel, the linear-light box average of the source footprint of the output pixel that will read it.
+// DXVK then picks the averaged value, so the presented image is a correct box-filtered downsample.
+
+static const char* kDownsampleFx = R"(
+texture SrcTex;
+sampler2D SrcS = sampler_state
+{
+    Texture = <SrcTex>;
+    MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
+    AddressU = CLAMP; AddressV = CLAMP;
+    SRGBTexture = FALSE;
+};
+float4 gSrc;   // width, height, 1/width, 1/height of the backbuffer
+float4 gRatio; // backbuffer / output, per axis
+
+float4 PS(float2 uv : TEXCOORD0) : COLOR
+{
+    float2 q = floor(uv * gSrc.xy);              // texel being written
+    float2 x = floor((q + 0.5) / gRatio.xy);     // output pixel that will fetch it
+    float2 c = (x + 0.5) * gRatio.xy;            // footprint center (texel units)
+    float2 h = gRatio.xy * 0.25;
+    // average in linear light: decode and encode here instead of relying on sRGB sampler/write states
+    float3 s = pow(tex2D(SrcS, (c + float2(-h.x, -h.y)) * gSrc.zw).rgb, 2.2);
+    s += pow(tex2D(SrcS, (c + float2( h.x, -h.y)) * gSrc.zw).rgb, 2.2);
+    s += pow(tex2D(SrcS, (c + float2(-h.x,  h.y)) * gSrc.zw).rgb, 2.2);
+    s += pow(tex2D(SrcS, (c + float2( h.x,  h.y)) * gSrc.zw).rgb, 2.2);
+    return float4(pow(s * 0.25, 1.0 / 2.2), 1.0);
+}
+
+technique Downsample
+{
+    pass P0
+    {
+        PixelShader = compile ps_3_0 PS();
+        ZEnable = FALSE; ZWriteEnable = FALSE; StencilEnable = FALSE;
+        AlphaBlendEnable = FALSE; AlphaTestEnable = FALSE; CullMode = NONE;
+        ColorWriteEnable = RED | GREEN | BLUE | ALPHA;
+        SRGBWriteEnable = FALSE;
+        ScissorTestEnable = FALSE;
+    }
+}
+)";
+
+static void leDSLog(const char* msg)
+{
+    wchar_t path[MAX_PATH];
+    GetModuleFileNameW(NULL, path, MAX_PATH);
+    auto file = std::filesystem::path(path).parent_path() / L"LibertyEdge.log";
+    FILE* f = nullptr;
+    if (_wfopen_s(&f, file.c_str(), L"a") == 0 && f)
+    {
+        fprintf(f, "%s\n", msg);
+        fclose(f);
+    }
+}
+
+export class LEDownsample
+{
+    template <typename T>
+    static void SafeRelease(T*& p) { if (p) { p->Release(); p = nullptr; } }
+
+    static inline ID3DXEffect* pEffect = nullptr;
+    static inline IDirect3DTexture9* pCopyTex = nullptr;
+    static inline IDirect3DSurface9* pCopySurf = nullptr;
+    static inline UINT copyW = 0, copyH = 0;
+    static inline D3DFORMAT copyFmt = D3DFMT_UNKNOWN;
+    static inline bool failed = false;
+    static inline int lastReason = -1;
+    static void reason(int code, const char* msg)
+    {
+        if (code != lastReason)
+        {
+            lastReason = code;
+            char b[256];
+            snprintf(b, sizeof(b), "Downsample: %s", msg);
+            leDSLog(b);
+        }
+    }
+
+public:
+    static inline bool active = false; // last frame was filtered (shown in the menu footer)
+
+    static void Shutdown()
+    {
+        SafeRelease(pCopySurf);
+        SafeRelease(pCopyTex);
+        SafeRelease(pEffect);
+        copyW = copyH = 0;
+        active = false;
+    }
+
+    static void Render(IDirect3DDevice9* device)
+    {
+        active = false;
+        if (!gLEDownsample) { reason(1, "off (Downsample = 0 in the ini)"); return; }
+        if (!device || !gWnd) { reason(2, "no device/window yet"); return; }
+        if (failed) return;
+
+        RECT cr = {};
+        GetClientRect(gWnd, &cr);
+        if (cr.right <= 0 || cr.bottom <= 0)
+            return;
+
+        IDirect3DSurface9* backBuffer = nullptr;
+        IDirect3DSwapChain9* swapChain = nullptr;
+        if (FAILED(device->GetSwapChain(0, &swapChain)) || !swapChain)
+        {
+            reason(3, "GetSwapChain failed");
+            return;
+        }
+        swapChain->GetBackBuffer(0, D3DBACKBUFFER_TYPE_MONO, &backBuffer);
+        swapChain->Release();
+        if (!backBuffer)
+        {
+            reason(4, "GetBackBuffer failed");
+            return;
+        }
+
+        D3DSURFACE_DESC desc{};
+        backBuffer->GetDesc(&desc);
+        if (desc.Width <= (UINT)cr.right && desc.Height <= (UINT)cr.bottom)
+        {
+            backBuffer->Release();
+            reason(5, "backbuffer is not larger than the window (not supersampling)");
+            return;
+        }
+
+        if (!pEffect)
+        {
+            leDSLog("Downsample: creating filter effect");
+            ID3DXBuffer* errors = nullptr;
+            if (FAILED(D3DXCreateEffect(device, kDownsampleFx, (UINT)strlen(kDownsampleFx), nullptr, nullptr, 0, nullptr, &pEffect, &errors)) || !pEffect)
+            {
+                FILE* f = nullptr;
+                wchar_t path[MAX_PATH];
+                GetModuleFileNameW(NULL, path, MAX_PATH);
+                auto file = std::filesystem::path(path).parent_path() / L"LibertyEdge.log";
+                if (_wfopen_s(&f, file.c_str(), L"a") == 0 && f)
+                {
+                    fprintf(f, "Downsample filter FAILED: %s\n", errors ? (const char*)errors->GetBufferPointer() : "unknown error");
+                    fclose(f);
+                }
+                SafeRelease(errors);
+                failed = true;
+                backBuffer->Release();
+                return;
+            }
+        }
+
+        if (!pCopyTex || copyW != desc.Width || copyH != desc.Height || copyFmt != desc.Format)
+        {
+            SafeRelease(pCopySurf);
+            SafeRelease(pCopyTex);
+            if (FAILED(device->CreateTexture(desc.Width, desc.Height, 1, D3DUSAGE_RENDERTARGET, desc.Format, D3DPOOL_DEFAULT, &pCopyTex, nullptr)) || !pCopyTex
+                || FAILED(pCopyTex->GetSurfaceLevel(0, &pCopySurf)))
+            {
+                SafeRelease(pCopyTex);
+                failed = true;
+                leDSLog("Downsample: CreateTexture FAILED (copy target)");
+                backBuffer->Release();
+                return;
+            }
+            copyW = desc.Width; copyH = desc.Height; copyFmt = desc.Format;
+        }
+
+        if (FAILED(device->StretchRect(backBuffer, nullptr, pCopySurf, nullptr, D3DTEXF_POINT)))
+        {
+            reason(6, "StretchRect backbuffer -> copy FAILED");
+            backBuffer->Release();
+            return;
+        }
+
+        IDirect3DSurface9* oldRT = nullptr;
+        D3DVIEWPORT9 oldVP{};
+        device->GetViewport(&oldVP);
+        device->GetRenderTarget(0, &oldRT);
+        device->SetRenderTarget(0, backBuffer);
+
+        IDirect3DVertexBuffer9* oldVB = nullptr;
+        IDirect3DVertexDeclaration9* oldDecl = nullptr;
+        UINT oldOffset = 0, oldStride = 0;
+        DWORD oldFVF = 0;
+        device->GetStreamSource(0, &oldVB, &oldOffset, &oldStride);
+        device->GetVertexDeclaration(&oldDecl);
+        device->GetFVF(&oldFVF);
+        device->SetStreamSource(0, nullptr, 0, 0);
+        device->SetVertexDeclaration(nullptr);
+        device->SetFVF(D3DFVF_XYZRHW | D3DFVF_TEX1);
+
+        D3DXVECTOR4 src((float)desc.Width, (float)desc.Height, 1.0f / desc.Width, 1.0f / desc.Height);
+        D3DXVECTOR4 ratio((float)desc.Width / cr.right, (float)desc.Height / cr.bottom, 0.0f, 0.0f);
+        pEffect->SetTexture(pEffect->GetParameterByName(nullptr, "SrcTex"), pCopyTex);
+        pEffect->SetVector(pEffect->GetParameterByName(nullptr, "gSrc"), &src);
+        pEffect->SetVector(pEffect->GetParameterByName(nullptr, "gRatio"), &ratio);
+        pEffect->SetTechnique(pEffect->GetTechniqueByName("Downsample"));
+
+        struct V { float x, y, z, rhw, u, v; };
+        V quad[4] =
+        {
+            { -0.5f,                    -0.5f,                     0.0f, 1.0f, 0.0f, 0.0f },
+            { -0.5f,                    float(desc.Height) - 0.5f, 0.0f, 1.0f, 0.0f, 1.0f },
+            { float(desc.Width) - 0.5f, -0.5f,                     0.0f, 1.0f, 1.0f, 0.0f },
+            { float(desc.Width) - 0.5f, float(desc.Height) - 0.5f, 0.0f, 1.0f, 1.0f, 1.0f },
+        };
+
+        UINT passes = 0;
+        HRESULT hrBegin = pEffect->Begin(&passes, 0);
+        if (SUCCEEDED(hrBegin))
+        {
+            HRESULT hrPass = pEffect->BeginPass(0);
+            if (SUCCEEDED(hrPass))
+            {
+                HRESULT hrDraw = device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, sizeof(V));
+                pEffect->EndPass();
+                if (SUCCEEDED(hrDraw))
+                {
+                    active = true;
+                    char b[160];
+                    snprintf(b, sizeof(b), "box filter active %ux%u -> %ldx%ld", desc.Width, desc.Height, cr.right, cr.bottom);
+                    reason(0, b);
+                }
+                else
+                    reason(7, "DrawPrimitiveUP FAILED");
+            }
+            else
+                reason(8, "BeginPass FAILED");
+            pEffect->End();
+        }
+        else
+            reason(9, "Effect Begin FAILED");
+        pEffect->SetTexture(pEffect->GetParameterByName(nullptr, "SrcTex"), nullptr);
+
+        device->SetStreamSource(0, oldVB, oldOffset, oldStride);
+        device->SetVertexDeclaration(oldDecl);
+        device->SetFVF(oldFVF);
+        SafeRelease(oldVB);
+        SafeRelease(oldDecl);
+
+        if (oldRT)
+        {
+            device->SetRenderTarget(0, oldRT);
+            oldRT->Release();
+        }
+        device->SetViewport(&oldVP);
+        backBuffer->Release();
+    }
+
+    LEDownsample()
+    {
+        FusionFix::onInitEvent() += []()
+        {
+            {
+                CIniReader iniReader("");
+                gLEDownsample = iniReader.ReadInteger("LIBERTYEDGE", "Downsample", 0) != 0;
+            }
+            // registered in the synchronous init so it runs before FusionFix's console gamma pass
+            FusionFix::onEndScene() += []()
+            {
+                LEDownsample::Render(rage::grcDevice::GetD3DDevice());
+            };
+
+            FusionFix::onBeforeReset() += []()
+            {
+                LEDownsample::Shutdown();
+            };
+        };
+    }
+} LEDownsample;
+
+export bool LEDownsampleActive() { return LEDownsample::active; }
