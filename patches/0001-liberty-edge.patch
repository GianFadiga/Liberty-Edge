index a6abeb9..0d792aa 100644
--- a/source/postfx.ixx
+++ b/source/postfx.ixx
@@ -192,6 +192,83 @@ public:
 
     bool bEnablePreAlphaDepth = false;
 
+    // ---- Liberty Edge: SMAA+ ([LIBERTYEDGE] in GTAIV.EFLC.FusionFix.ini, selected in the menu) ----
+    float leTexThreshold = 0.10f;
+    float leGeoThreshold = 0.03f;
+    float leDepthRel = 0.08f;
+    int leSearchSteps = 32;
+    int leSearchStepsDiag = 16;
+    struct LESMAASet
+    {
+        IDirect3DPixelShader9* edgePS = nullptr;
+        IDirect3DPixelShader9* weightsPS = nullptr;
+        IDirect3DPixelShader9* blendPS = nullptr;
+        IDirect3DVertexShader9* edgeVS = nullptr;
+        IDirect3DVertexShader9* weightsVS = nullptr;
+        IDirect3DVertexShader9* blendVS = nullptr;
+        bool ok() const { return edgePS && weightsPS && blendPS && edgeVS && weightsVS && blendVS; }
+    } leSet[2]; // 0 = SMAA+, 1 = SMAA+ Debug
+
+    static void leLog(const std::string& line, bool truncate = false)
+    {
+        wchar_t path[MAX_PATH];
+        GetModuleFileNameW(NULL, path, MAX_PATH);
+        auto file = std::filesystem::path(path).parent_path() / L"LibertyEdge.log";
+        FILE* f = nullptr;
+        if (_wfopen_s(&f, file.c_str(), truncate ? L"w" : L"a") == 0 && f)
+        {
+            fprintf(f, "%s\n", line.c_str());
+            fclose(f);
+        }
+    }
+
+    void leCompileSMAAPlus(LPDIRECT3DDEVICE9 pDevice, HMODULE hm)
+    {
+        for (int v = 0; v < 2; v++)
+        {
+            auto& set = leSet[v];
+            if (set.ok())
+                continue;
+            auto f = [](float x) { char b[32]; snprintf(b, sizeof(b), "%.4f", x); return std::string(b); };
+            std::string vals[8] = { "1", f(leTexThreshold), f(leGeoThreshold), f(leDepthRel), std::to_string(leSearchSteps), std::to_string(leSearchStepsDiag), bEnablePreAlphaDepth ? "1" : "0", v == 1 ? "1" : "0" };
+            const char* names[8] = { "LE_SMAAPLUS", "LE_TEX_THRESHOLD", "LE_GEO_THRESHOLD", "LE_DEPTH_REL", "LE_SEARCH_STEPS", "LE_SEARCH_STEPS_DIAG", "LE_PREDICATION", "LE_DEBUG" };
+            D3DXMACRO macros[9] = {};
+            for (int i = 0; i < 8; i++) { macros[i].Name = names[i]; macros[i].Definition = vals[i].c_str(); }
+
+            auto compile = [&](const char* entry, const char* profile, auto& out)
+            {
+                ID3DXBuffer* code = nullptr;
+                ID3DXBuffer* err = nullptr;
+                ID3DXConstantTable* ct = nullptr;
+                if (D3DXCompileShaderFromResourceW(hm, MAKEINTRESOURCEW(IDR_SMAA), macros, NULL, entry, profile, 0, &code, &err, &ct) == S_OK && code)
+                {
+                    HRESULT hr;
+                    if constexpr (std::is_same_v<std::remove_reference_t<decltype(out)>, IDirect3DPixelShader9*>)
+                        hr = pDevice->CreatePixelShader((DWORD*)code->GetBufferPointer(), &out);
+                    else
+                        hr = pDevice->CreateVertexShader((DWORD*)code->GetBufferPointer(), &out);
+                    if (hr != S_OK)
+                        out = nullptr;
+                }
+                else
+                {
+                    leLog(std::string("SMAA+ compile FAILED (") + entry + (v ? ", debug" : "") + "): " + (err ? (const char*)err->GetBufferPointer() : "unknown error"));
+                }
+                SAFE_RELEASE(code);
+                SAFE_RELEASE(err);
+                SAFE_RELEASE(ct);
+            };
+            compile("DX9_SMAALumaEdgeDetectionPS", "ps_3_0", set.edgePS);
+            compile("DX9_SMAABlendingWeightCalculationPS", "ps_3_0", set.weightsPS);
+            compile("DX9_SMAANeighborhoodBlendingPS", "ps_3_0", set.blendPS);
+            compile("DX9_SMAAEdgeDetectionVS", "vs_3_0", set.edgeVS);
+            compile("DX9_SMAABlendingWeightCalculationVS", "vs_3_0", set.weightsVS);
+            compile("DX9_SMAANeighborhoodBlendingVS", "vs_3_0", set.blendVS);
+            leLog(std::string(v ? "SMAA+ Debug" : "SMAA+") + (set.ok() ? " shaders: OK" : " shaders: NOT AVAILABLE (stock SMAA is used instead)"));
+        }
+        gLEPlusReady = leSet[0].ok();
+    }
+
     int nAmbientOcclusionSamples = 9;
     int nAmbientOcclusionBlurPasses = 1;
     int nAmbientOcclusionLogMaxOffset = 3;
