 /**
  * Adjusts the threshold by means of predication.
  */
+#ifdef LE_SMAAPLUS
+// Liberty Edge: depth edge from relative depth jump; works with forward or reversed, non-linear depth
+float2 LE_DepthEdges(float2 texcoord, float4 offset[3], SMAATexture2D(depthTex)) {
+    float3 n = SMAAGatherNeighbours(texcoord, offset, depthTex);
+    float3 w = max(min(n, 1.0 - n), 1e-6);
+    float2 rel = abs(w.xx - w.yz) / max(w.xx, w.yz);
+    return step(LE_DEPTH_REL, rel);
+}
+float2 SMAACalculatePredicatedThreshold(float2 texcoord,
+                                        float4 offset[3],
+                                        SMAATexture2D(predicationTex)) {
+    float2 edges = LE_DepthEdges(texcoord, offset, predicationTex);
+    return lerp(float2(LE_TEX_THRESHOLD, LE_TEX_THRESHOLD), float2(LE_GEO_THRESHOLD, LE_GEO_THRESHOLD), edges);
+}
+#else
 float2 SMAACalculatePredicatedThreshold(float2 texcoord,
                                         float4 offset[3],
                                         SMAATexture2D(predicationTex)) {
@@ -636,6 +659,7 @@ float2 SMAACalculatePredicatedThreshold(float2 texcoord,
     float2 edges = step(SMAA_PREDICATION_THRESHOLD, delta);
     return SMAA_PREDICATION_SCALE * SMAA_THRESHOLD * (1.0 - SMAA_PREDICATION_STRENGTH * edges);
 }
+#endif
 
