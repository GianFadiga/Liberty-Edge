@@ -107,3 +107,12 @@ RightIndicatorKey = 0xDD                      // VK_OEM_6, the Right Brace key
 [EXPERIMENTAL]
 DisplayMemoryStats = 0                        // while the FPS Counter is enabled, it prints some memory counters alongside, like for used streaming memory and memory used by the entire process
 ReflectionMSAAQuality = 0                     // Applies MSAA to the reflection maps (exterior, interior, water, mirror) like on Xbox 360. Valid options: 2|4|8, other values are ignored and disable this feature.
+
+[LIBERTYEDGE]                                 // Liberty Edge: improved SMAA (used when the in-game Antialiasing option is SMAA)
+SMAAPlus = 1                                  // 0: stock FusionFix SMAA | 1: SMAA+ (color edges + depth-aware thresholds)
+TextureThreshold = 0.10                       // edge sensitivity on surface detail (higher = sharper textures, less AA on texture noise)
+GeometryThreshold = 0.03                      // edge sensitivity on object silhouettes (lower = more AA on poles, wires, fences)
+DepthEdgeSensitivity = 0.08                   // relative depth jump that counts as a silhouette
+SearchSteps = 32                              // edge search length (longer = smoother near-horizontal lines)
+SearchStepsDiagonal = 16                      // diagonal edge search length
+SMAAPlusDebug = 0                             // 1: shows the edge mask (red/green = processed edges, blue = depth edges)
